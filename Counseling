import argparse, csv, datetime as dt, hmac, io, os, re, secrets, sqlite3, time, webbrowser
from flask import Flask, Response, jsonify, request

DB_FILE = os.environ.get("DB_FILE", "free_counseling.db")
ADMIN_PASSWORD = os.environ.get("ADMIN_PASSWORD", "icct-admin-2026")
COURSES = ["BSIT", "BSCS", "BSBA", "BSHM", "BSOA", "BSE", "BSED", "Other"]
YEARS = ["1st Year", "2nd Year", "3rd Year", "4th Year"]
SLOTS = ["09:00", "10:00", "11:00", "13:00", "14:00", "15:00", "16:00"]
DAYS_AHEAD, MAX_ACTIVE = 14, 3
TOKENS = set()


def db():
    con = sqlite3.connect(DB_FILE, timeout=10)
    con.row_factory = sqlite3.Row
    return con


def init_db():
    with db() as c:
        c.execute("""CREATE TABLE IF NOT EXISTS bookings(
            id INTEGER PRIMARY KEY AUTOINCREMENT, student_id TEXT NOT NULL, name TEXT NOT NULL,
            course TEXT, year TEXT, email TEXT, phone TEXT, notes TEXT, date TEXT NOT NULL, time TEXT NOT NULL,
            status TEXT NOT NULL DEFAULT 'Booked', created_at TEXT NOT NULL)""")
        c.execute("""CREATE UNIQUE INDEX IF NOT EXISTS uq_active_slot2
            ON bookings(date,time) WHERE status='Booked'""")


def weekdays():
    out, d = [], dt.date.today()
    while len(out) < DAYS_AHEAD:
        if d.weekday() < 5:
            out.append(d.isoformat())
        d += dt.timedelta(days=1)
    return out


def free_slots(con, date):
    taken = {r["time"] for r in con.execute(
        "SELECT time FROM bookings WHERE date=? AND status='Booked'", (date,))}
    now = dt.datetime.now()
    return [t for t in SLOTS if t not in taken and
            not (date == now.date().isoformat() and t <= now.strftime("%H:%M"))]


class Err(Exception):
    def __init__(self, msg, code=400):
        self.msg, self.code = msg, code


def book(d):
    g = lambda k: str(d.get(k, "")).strip()
    sid, name, email = g("student_id").upper(), g("name"), g("email").lower()
    phone = g("phone").replace(" ", "")
    if not re.fullmatch(r"\d{2}-?\d{3,6}|[A-Z0-9-]{5,15}", sid): raise Err("Invalid Student ID.")
    if len(name) < 3 or len(name) > 80: raise Err("Enter your full name.")
    if not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email): raise Err("Invalid email address.")
    if not re.fullmatch(r"(09|\+639)\d{9}", phone): raise Err("Mobile must be 09XXXXXXXXX.")
    for k, allowed in (("course", COURSES), ("year", YEARS),
                       ("date", weekdays()), ("time", SLOTS)):
        if g(k) not in allowed: raise Err(f"Please choose a valid {k}.")
    with db() as c:
        if g("time") not in free_slots(c, g("date")):
            raise Err("That slot is no longer available.", 409)
        act = c.execute("SELECT date FROM bookings WHERE student_id=? AND status='Booked' AND date>=?",
                        (sid, dt.date.today().isoformat())).fetchall()
        if len(act) >= MAX_ACTIVE: raise Err(f"Max {MAX_ACTIVE} active bookings reached.")
        if any(a["date"] == g("date") for a in act): raise Err("You already have a session that day.")
        try:
            c.execute("""INSERT INTO bookings(student_id,name,course,year,email,phone,
                notes,date,time,created_at) VALUES(?,?,?,?,?,?,?,?,?,?)""",
                      (sid, name.title(), g("course"), g("year"), email, phone,
                       g("notes")[:500], g("date"), g("time"),
                       dt.datetime.now().isoformat(timespec="seconds")))
        except sqlite3.IntegrityError:
            raise Err("That slot was just taken.", 409)
    return {"ok": True}


