# ================================ FLASK APP ================================
app = Flask(__name__)
app.config["MAX_CONTENT_LENGTH"] = 20000
init_db()


@app.after_request
def secure_headers(r):
    r.headers["X-Content-Type-Options"] = "nosniff"
    r.headers["Content-Security-Policy"] = (
        "default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'")
    return r


@app.errorhandler(Err)
def on_err(e):
    return jsonify(error=e.msg), e.code


@app.errorhandler(413)
def on_big(_):
    return jsonify(error="Too large."), 413


@app.errorhandler(404)
def on_404(_):
    return jsonify(error="Not found."), 404


@app.errorhandler(sqlite3.IntegrityError)
def on_integrity(_):
    return jsonify(error="Slot already taken."), 409


def need_admin():
    if request.headers.get("X-Token", "") not in TOKENS:
        raise Err("Admin login required.", 401)


def payload():
    return request.get_json(silent=True) or {}


@app.get("/")
def index():
    return Response(PAGE, mimetype="text/html")


@app.get("/api/config")
def config():
    return jsonify(courses=COURSES, years=YEARS, dates=weekdays())


@app.get("/api/slots")
def slots():
    with db() as c:
        return jsonify(free_slots(c, request.args.get("date", "")))


@app.post("/api/book")
def api_book():
    return jsonify(book(payload()))


@app.get("/api/my")
def my():
    with db() as c:
        rows = c.execute("SELECT id,date,time,status FROM bookings "
                         "WHERE student_id=? ORDER BY date DESC,time DESC",
                         (request.args.get("sid", "").strip().upper(),)).fetchall()
    return jsonify([dict(r) for r in rows])


@app.post("/api/cancel")
def cancel():
    d = payload()
    with db() as c:
        cur = c.execute("UPDATE bookings SET status='Cancelled' WHERE id=? AND student_id=? "
                        "AND status='Booked'", (d.get("id"), str(d.get("student_id", "")).upper()))
    if not cur.rowcount:
        raise Err("Nothing to cancel.", 404)
    return jsonify(ok=True)


@app.post("/api/admin/login")
def login():
    if hmac.compare_digest(str(payload().get("password", "")), ADMIN_PASSWORD):
        t = secrets.token_hex(24)
        TOKENS.add(t)
        return jsonify(token=t)
    time.sleep(1)
    raise Err("Wrong password.", 401)


@app.get("/api/admin/list")
def admin_list():
    need_admin()
    like = f"%{request.args.get('q', '').strip()}%"
    with db() as c:
        rows = c.execute("SELECT * FROM bookings WHERE student_id LIKE ? OR name LIKE ? "
                         "OR date LIKE ? OR status LIKE ? "
                         "ORDER BY date DESC,time DESC", (like,) * 4).fetchall()
    return jsonify([dict(r) for r in rows])


@app.post("/api/admin/status")
def admin_status():
    need_admin()
    d = payload()
    if d.get("status") not in ("Booked", "Completed", "No-show", "Cancelled"):
        raise Err("Bad status.")
    with db() as c:
        c.execute("UPDATE bookings SET status=? WHERE id=?", (d["status"], d.get("id")))
    return jsonify(ok=True)


@app.get("/api/admin/export")
def export():
    need_admin()
    with db() as c:
        rows = c.execute("SELECT * FROM bookings ORDER BY date,time").fetchall()
    s = io.StringIO()
    w = csv.writer(s)
    if rows:
        w.writerow(rows[0].keys())
        w.writerows([tuple(r) for r in rows])
    return Response(s.getvalue(), mimetype="text/csv")


