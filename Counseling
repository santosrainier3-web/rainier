        now = dt.datetime.now()
        free = []
        for t in SLOTS:
            if t in taken:
                continue
            if d == now.date().isoformat() and t <= now.strftime("%H:%M"):
                continue
            free.append(t)
        self.cb_time["values"] = free
        if self.v["time"].get() not in free:
            self.v["time"].set("")
        self.lbl_status.config(
            text=f"{len(free)} slot(s) open" if free else "Fully booked - pick another day/counselor",
            fg=OK if free else BAD)

