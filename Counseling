.tabs button{background:var(--p);color:var(--mu);border:0;padding:11px 22px;border-radius:10px 10px 0 0;font-weight:600;cursor:pointer}
.tabs button.on{background:var(--ac);color:#fff}.card{background:var(--p);padding:22px;border-radius:0 14px 14px 14px;
box-shadow:0 20px 50px #0008}.g{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:640px){.g{grid-template-columns:1fr}}label{display:block;color:var(--mu);font-size:13px;margin-bottom:4px}
input,select,textarea{width:100%;background:var(--p2);color:var(--tx);border:1px solid #3a2f8f;border-radius:9px;padding:10px;font:inherit}
input:focus,select:focus,textarea:focus{outline:2px solid var(--ac)}.full{grid-column:1/-1}
.btn{background:var(--ac);color:#fff;border:0;padding:11px 22px;border-radius:10px;font-weight:700;cursor:pointer}
.btn:hover{background:var(--ach)}.btn.g2{background:var(--p2)}.btn.d{background:#6a1f45}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px}.row input{flex:1;min-width:160px}
.hint{color:var(--mu);font-size:13px;margin-top:6px}.hint.ok{color:var(--ok)}.hint.bad{color:var(--bad)}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse}th{background:var(--ac);text-align:left;padding:9px;font-size:13px}
td{padding:9px;border-bottom:1px solid #2c2470;background:var(--p2)}tr.sel td{background:#3b2ca3}tbody tr{cursor:pointer}
.s-Booked{color:var(--ok)}.s-Cancelled{color:var(--bad)}.s-Completed{color:var(--mu)}.s-No-show{color:#ffb86b}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(90px);padding:13px 22px;border-radius:12px;
background:var(--p2);border:1px solid var(--ac);transition:.3s;max-width:90vw}#toast.show{transform:translateX(-50%)}
#toast.ok{border-color:var(--ok)}#toast.bad{border-color:var(--bad)}.hide{display:none}
</style></head><body><div class="w">
<h1>ICCT Free Student Counseling</h1>
<p class="sub">Reserve a private, confidential session with a counselor - 100% free for enrolled students.</p>
<div class="tabs"><button class="on" data-t="b">Book a Session</button><button data-t="m">My Bookings</button><button data-t="a">Admin</button></div>
<div class="card">
<section id="b"><div class="g">
<div><label>Student ID (e.g. 24-12345)</label><input id="student_id"></div>
<div><label>Full Name</label><input id="name"></div>
<div><label>Email</label><input id="email" type="email"></div>
<div><label>Mobile (09XXXXXXXXX)</label><input id="phone"></div>
<div><label>Course</label><select id="course"></select></div>
<div><label>Year Level</label><select id="year"></select></div>
<div><label>Counselor</label><select id="counselor"></select></div>
<div><label>Concern</label><select id="concern"></select></div>
<div><label>Date (weekdays)</label><select id="date"></select></div>
<div><label>Available Time</label><select id="time"></select><div id="sh" class="hint"></div></div>
<div class="full"><label>Note for the counselor (optional)</label><textarea id="notes" rows="3" maxlength="500"></textarea></div>
<div class="full"><button class="btn" id="go">Reserve Schedule</button></div></div></section>
<section id="m" class="hide"><div class="row"><input id="msid" placeholder="Your Student ID">
<button class="btn" id="mgo">Find My Bookings</button><button class="btn d" id="mcx">Cancel Selected</button></div>
<div class="tw" id="mt"></div></section>
<section id="a" class="hide"><div id="lg" class="row"><input id="pw" type="password" placeholder="Admin password">
<button class="btn" id="lgo">Unlock</button></div>
<div id="ap" class="hide"><div class="row"><input id="q" placeholder="Search ID / name / date / status">
<button class="btn g2" data-st="Completed">Completed</button><button class="btn g2" data-st="No-show">No-show</button>
<button class="btn d" data-st="Cancelled">Cancel</button><button class="btn" id="ex">Export CSV</button></div>
<div class="tw" id="at"></div><div class="hint" id="stats"></div></div></section>
</div></div><div id="toast"></div>
<script>
const $=s=>document.querySelector(s);let TOKEN=null,SEL={m:null,a:null};
const el=(t,x,c)=>{const e=document.createElement(t);if(x!==undefined)e.textContent=x;if(c)e.className=c;return e};
function toast(m,ok=true){const t=$('#toast');t.textContent=m;t.className='show '+(ok?'ok':'bad');clearTimeout(t._h);t._h=setTimeout(()=>t.className='',3800)}
async function api(p,body){const o=body===undefined?{}:{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)};
 if(TOKEN)(o.headers=o.headers||{})['X-Token']=TOKEN;const r=await fetch(p,o);
 if(p.includes('export')&&r.ok)return r.blob();const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Error');return d}
function fill(id,v){const s=$('#'+id);s.replaceChildren();const o=el('option','Select...');o.value='';s.append(o);v.forEach(x=>{const o=el('option',x);o.value=x;s.append(o)})}
function table(box,rows,cols,key){const t=el('table'),h=el('tr');cols.forEach(c=>h.append(el('th',c[1])));t.append(el('thead')).append(h);
 const b=el('tbody');rows.forEach(r=>{const tr=el('tr');cols.forEach(c=>tr.append(el('td',r[c[0]],c[0]=='status'?'s-'+r.status:'')));
 tr.onclick=()=>{b.querySelectorAll('tr').forEach(x=>x.classList.remove('sel'));tr.classList.add('sel');SEL[key]=r};b.append(tr)});
 t.append(b);box.replaceChildren(t);SEL[key]=null}
document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tabs button').forEach(x=>x.classList.toggle('on',x==b));
 ['b','m','a'].forEach(k=>$('#'+k).classList.toggle('hide',k!=b.dataset.t))});
async function slots(){const c=$('#counselor').value,d=$('#date').value;if(!c||!d)return fill('time',[]);
 const s=await api(`/api/slots?counselor=${encodeURIComponent(c)}&date=${d}`);fill('time',s);
 $('#sh').textContent=s.length?s.length+' slot(s) open':'Fully booked - try another day/counselor';$('#sh').className='hint '+(s.length?'ok':'bad')}
$('#counselor').onchange=$('#date').onchange=()=>slots().catch(e=>toast(e.message,false));
$('#go').onclick=async()=>{const d={};['student_id','name','email','phone','course','year','counselor','concern','date','time','notes'].forEach(k=>d[k]=$('#'+k).value);
 try{await api('/api/book',d);toast('Reservation confirmed for '+d.date+' at '+d.time+'. Bring your school ID!');
 ['student_id','name','email','phone','notes'].forEach(k=>$('#'+k).value='');await slots()}catch(e){toast(e.message,false);slots()}};
const MC=[['id','ID'],['date','Date'],['time','Time'],['counselor','Counselor'],['concern','Concern'],['status','Status']];
async function mine(){const s=$('#msid').value.trim();if(!s)return toast('Enter your Student ID',false);
 const r=await api('/api/my?sid='+encodeURIComponent(s));table($('#mt'),r,MC,'m');if(!r.length)toast('No bookings found',false)}
$('#mgo').onclick=()=>mine().catch(e=>toast(e.message,false));
$('#mcx').onclick=async()=>{const r=SEL.m;if(!r)return toast('Select a booking first',false);if(!confirm('Cancel '+r.date+' '+r.time+'?'))return;
 try{await api('/api/cancel',{id:r.id,student_id:$('#msid').value});toast('Booking cancelled');mine();slots()}catch(e){toast(e.message,false)}};
$('#lgo').onclick=async()=>{try{TOKEN=(await api('/api/admin/login',{password:$('#pw').value})).token;$('#lg').classList.add('hide');$('#ap').classList.remove('hide');adm()}catch(e){toast(e.message,false)}};
async function adm(){const r=await api('/api/admin/list?q='+encodeURIComponent($('#q').value));
 table($('#at'),r,[['id','ID'],['student_id','Student'],['name','Name'],...MC.slice(1)],'a');
 const n=s=>r.filter(x=>x.status==s).length;$('#stats').textContent=`Total ${r.length} | Booked ${n('Booked')} | Completed ${n('Completed')} | Cancelled ${n('Cancelled')} | No-show ${n('No-show')}`}
$('#q').oninput=()=>adm().catch(()=>{});
document.querySelectorAll('[data-st]').forEach(b=>b.onclick=async()=>{if(!SEL.a)return toast('Select a booking first',false);
 await api('/api/admin/status',{id:SEL.a.id,status:b.dataset.st});adm();slots()});
$('#ex').onclick=async()=>{const a=el('a');a.href=URL.createObjectURL(await api('/api/admin/export'));a.download='counseling_bookings.csv';a.click()};
(async()=>{const c=await api('/api/config');fill('course',c.courses);fill('year',c.years);fill('counselor',c.counselors);fill('concern',c.concerns);fill('date',c.dates);fill('time',[])})();
</script></body></html>"""

