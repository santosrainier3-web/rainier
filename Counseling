from urllib.parse import urlparse, parse_qs

DB_FILE = "counseling.db"
ADMIN_PASSWORD = os.environ.get("ADMIN_PASSWORD", "icct-admin-2026")
COUNSELORS = ["Ms. Santos - Guidance Counselor", "Mr. Dela Cruz - Guidance Counselor",
              "Ms. Reyes - Peer Counselor Coordinator"]
CONCERNS = ["Academic Stress", "Personal / Family", "Career Guidance",
            "Anxiety / Mental Health", "Relationships", "Financial Concerns", "Others"]
COURSES = ["BSIT", "BSCS", "BSBA", "BSHM", "BSOA", "BSE", "BSED", "Other"]
YEARS = ["1st Year", "2nd Year", "3rd Year", "4th Year"]
SLOTS = ["09:00", "10:00", "11:00", "13:00", "14:00", "15:00", "16:00"]
DAYS_AHEAD, MAX_ACTIVE = 14, 3
TOKENS = set()


def db():
    con = sqlite3.connect(DB_FILE, timeout=10)
    con.row_factory = sqlite3.Row
    return con


def init_db():
    with db() as c:
        c.execute("""CREATE TABLE IF NOT EXISTS bookings(
            id INTEGER PRIMARY KEY AUTOINCREMENT, student_id TEXT NOT NULL, name TEXT NOT NULL,
            course TEXT, year TEXT, email TEXT, phone TEXT, counselor TEXT NOT NULL,
            concern TEXT, notes TEXT, date TEXT NOT NULL, time TEXT NOT NULL,
            status TEXT NOT NULL DEFAULT 'Booked', created_at TEXT NOT NULL)""")
        c.execute("""CREATE UNIQUE INDEX IF NOT EXISTS uq_active_slot
            ON bookings(counselor,date,time) WHERE status='Booked'""")


def weekdays():
    out, d = [], dt.date.today()
    while len(out) < DAYS_AHEAD:
        if d.weekday() < 5:
            out.append(d.isoformat())
        d += dt.timedelta(days=1)
    return out


def free_slots(con, counselor, date):
    taken = {r["time"] for r in con.execute(
        "SELECT time FROM bookings WHERE counselor=? AND date=? AND status='Booked'",
        (counselor, date))}
    now = dt.datetime.now()
    return [t for t in SLOTS if t not in taken and
            not (date == now.date().isoformat() and t <= now.strftime("%H:%M"))]


class Err(Exception):
    def __init__(self, msg, code=400):
        self.msg, self.code = msg, code


def book(d):
    g = lambda k: str(d.get(k, "")).strip()
    sid, name, email = g("student_id").upper(), g("name"), g("email").lower()
    phone = g("phone").replace(" ", "")
    if not re.fullmatch(r"\d{2}-?\d{3,6}|[A-Z0-9-]{5,15}", sid): raise Err("Invalid Student ID.")
    if len(name) < 3 or len(name) > 80: raise Err("Enter your full name.")
    if not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email): raise Err("Invalid email address.")
    if not re.fullmatch(r"(09|\+639)\d{9}", phone): raise Err("Mobile must be 09XXXXXXXXX.")
    for k, allowed in (("course", COURSES), ("year", YEARS), ("counselor", COUNSELORS),
                       ("concern", CONCERNS), ("date", weekdays()), ("time", SLOTS)):
        if g(k) not in allowed: raise Err(f"Please choose a valid {k}.")
    with db() as c:
        if g("time") not in free_slots(c, g("counselor"), g("date")):
            raise Err("That slot is no longer available.", 409)
        act = c.execute("SELECT date FROM bookings WHERE student_id=? AND status='Booked' AND date>=?",
                        (sid, dt.date.today().isoformat())).fetchall()
        if len(act) >= MAX_ACTIVE: raise Err(f"Max {MAX_ACTIVE} active bookings reached.")
        if any(a["date"] == g("date") for a in act): raise Err("You already have a session that day.")
        try:
            c.execute("""INSERT INTO bookings(student_id,name,course,year,email,phone,counselor,
                concern,notes,date,time,created_at) VALUES(?,?,?,?,?,?,?,?,?,?,?,?)""",
                      (sid, name.title(), g("course"), g("year"), email, phone, g("counselor"),
                       g("concern"), g("notes")[:500], g("date"), g("time"),
                       dt.datetime.now().isoformat(timespec="seconds")))
        except sqlite3.IntegrityError:
            raise Err("That slot was just taken.", 409)
    return {"ok": True}


class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def out(self, code, body, ctype="application/json", extra=None):
        if not isinstance(body, (bytes, str)): body = json.dumps(body)
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(b)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'")
        for k, v in (extra or {}).items(): self.send_header(k, v)
        self.end_headers()
        self.wfile.write(b)

    def admin(self):
        if self.headers.get("X-Token", "") not in TOKENS: raise Err("Admin login required.", 401)

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > 20000: raise Err("Too large.", 413)
        try: return json.loads(self.rfile.read(n) or b"{}")
        except ValueError: raise Err("Bad JSON.")

    def route(self, method):
        u = urlparse(self.path); q = {k: v[0] for k, v in parse_qs(u.query).items()}; p = u.path
        if method == "GET":
            if p == "/": return self.out(200, PAGE, "text/html")
            if p == "/api/config":
                return self.out(200, dict(counselors=COUNSELORS, concerns=CONCERNS, courses=COURSES,
                                          years=YEARS, dates=weekdays()))
            if p == "/api/slots":
                with db() as c: return self.out(200, free_slots(c, q.get("counselor", ""), q.get("date", "")))
            if p == "/api/my":
                with db() as c:
                    rows = c.execute("SELECT id,date,time,counselor,concern,status FROM bookings "
                                     "WHERE student_id=? ORDER BY date DESC,time DESC",
                                     (q.get("sid", "").strip().upper(),)).fetchall()
                return self.out(200, [dict(r) for r in rows])
            if p == "/api/admin/list":
                self.admin(); like = f"%{q.get('q', '').strip()}%"
                with db() as c:
                    rows = c.execute("SELECT * FROM bookings WHERE student_id LIKE ? OR name LIKE ? "
                                     "OR counselor LIKE ? OR date LIKE ? OR status LIKE ? "
                                     "ORDER BY date DESC,time DESC", (like,) * 5).fetchall()
                return self.out(200, [dict(r) for r in rows])
            if p == "/api/admin/export":
                self.admin()
                with db() as c: rows = c.execute("SELECT * FROM bookings ORDER BY date,time").fetchall()
                s = io.StringIO(); w = csv.writer(s)
                if rows: w.writerow(rows[0].keys()); w.writerows([tuple(r) for r in rows])
                return self.out(200, s.getvalue(), "text/csv")
        else:
            d = self.body()
            if p == "/api/book": return self.out(200, book(d))
            if p == "/api/cancel":
                with db() as c:
                    cur = c.execute("UPDATE bookings SET status='Cancelled' WHERE id=? AND student_id=? "
                                    "AND status='Booked'", (d.get("id"), str(d.get("student_id", "")).upper()))
                if not cur.rowcount: raise Err("Nothing to cancel.", 404)
                return self.out(200, {"ok": True})
            if p == "/api/admin/login":
                if hmac.compare_digest(str(d.get("password", "")), ADMIN_PASSWORD):
                    t = secrets.token_hex(24); TOKENS.add(t); return self.out(200, {"token": t})
                time.sleep(1); raise Err("Wrong password.", 401)
            if p == "/api/admin/status":
                self.admin()
                if d.get("status") not in ("Booked", "Completed", "No-show", "Cancelled"): raise Err("Bad status.")
                with db() as c: c.execute("UPDATE bookings SET status=? WHERE id=?", (d["status"], d.get("id")))
                return self.out(200, {"ok": True})
        raise Err("Not found.", 404)

    def handle_any(self, method):
        try: self.route(method)
        except Err as e: self.out(e.code, {"error": e.msg})
        except sqlite3.IntegrityError: self.out(409, {"error": "Slot already taken."})
        except Exception as e: self.out(500, {"error": "Server error."}); print("ERR", e)

    def do_GET(self): self.handle_any("GET")
    def do_POST(self): self.handle_any("POST")


